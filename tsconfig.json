{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    // server/host.ts imports src/net/protocol.ts with the .ts extension because
    // node --experimental-strip-types requires one. Safe with noEmit.
    "allowImportingTsExtensions": true,
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    // import.meta.env, used to keep the service worker out of dev.
    // "node" is for vite.config.ts alone, which reads assets/ to hash it.
    "types": ["vite/client", "node"],

    "strict": true,
    "noUncheckedIndexedAccess": false,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": false,

    "noEmit": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src", "server", "vite.config.ts"]
}
